# Copy to .env.local (gitignored, matches *.local) and fill in real values.
# Never commit .env.local — that's the point.

# Phone number shown on the /card/:slug business card and included in its
# downloadable vCard. Also set as the JUSTIN_PHONE repository secret in
# GitHub Actions so the deployed build picks it up (Settings > Secrets and
# variables > Actions > New repository secret).
VITE_JUSTIN_PHONE="+1 (000) 000-0000"
